<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cicoding.provider.file.dao.UserDao">

    <resultMap id="BaseResultMap" type="cn.cicoding.provider.file.model.UserDomain">
        <id column="id" property="id"/>
        <result column="user_name" property="userName"/>
        <result column="password" property="password"/>
        <result column="phone" property="phone"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="cn.cicoding.provider.file.model.UserDomain">
        INSERT INTO t_user(user_name, password, phone)
        VALUES (#{userName}, #{password}, #{phone})
    </insert>

    <delete id="deleteUserById">
        DELETE FROM t_user WHERE id = #{userId}
    </delete>

    <update id="updateUser" parameterType="cn.cicoding.provider.file.model.UserDomain">
        UPDATE t_user
        <set>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="password != null">password = #{password},</if>
            <if test="phone != null">phone = #{phone},</if>
        </set>
        WHERE id = #{id}
    </update>

    <select id="selectUsers" resultMap="BaseResultMap">
        SELECT * FROM t_user
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM t_user WHERE id = #{id}
    </select>

</mapper>
